# WIT ver3.0 환경변수 템플릿
#
# 이 파일을 .env로 복사한 뒤 실제 값을 채운다. .env는 커밋되지 않는다.
#   cp .env.example .env
#
# 값이 비어 있어도 앱은 기동된다. 다만 해당 기능은 동작하지 않는다.
# (아직 구현 전인 라우팅/히트맵 키 때문에 기동이 막히지 않도록 의도한 것)

# ─────────────────────────────────────────────
# 데이터베이스
# ─────────────────────────────────────────────
# ver3에서 PostgreSQL + PostGIS로 전환 예정. 현재는 MySQL 기준 기본값.
# 전환 후 예시:
#   DB_DRIVER=org.postgresql.Driver
#   DB_URL=jdbc:postgresql://localhost:5432/wit
#   JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_URL=jdbc:mysql://localhost:3306/wit?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=

# 운영에서는 validate 권장. 개발 중에는 update.
JPA_DDL_AUTO=update
JPA_DIALECT=org.hibernate.dialect.MySQL8Dialect

# ─────────────────────────────────────────────
# 메일 (이메일 인증코드 발송)
# ─────────────────────────────────────────────
# Gmail 사용 시 계정 비밀번호가 아니라 "앱 비밀번호"를 발급받아 넣어야 한다.
# https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ─────────────────────────────────────────────
# Redis (이메일 인증코드 TTL 저장)
# ─────────────────────────────────────────────
# 로컬은 그대로. Upstash 등 관리형 사용 시 REDIS_SSL=true 필요.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_SSL=false
REDIS_PASSWORD=

# ─────────────────────────────────────────────
# 이미지 저장소 (S3 호환)
# ─────────────────────────────────────────────
# ver3에서 Cloudflare R2로 전환 예정.
# R2 사용 시 STORAGE_ENDPOINT를 채우면 되고, 비워두면 AWS S3로 동작한다.
#   STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=ap-northeast-2
STORAGE_BUCKET=
STORAGE_ENDPOINT=

# ─────────────────────────────────────────────
# 카카오맵
# ─────────────────────────────────────────────
# JS 키: 브라우저에 노출되는 것이 정상이나,
#        카카오 콘솔에서 반드시 도메인 화이트리스트를 걸어야 한다.
#        (등록하지 않으면 타 사이트가 내 쿼터를 소모할 수 있음)
# REST 키: 서버 전용. 지오코딩/장소검색에 사용하며 클라이언트로 절대 내보내지 않는다.
# https://developers.kakao.com
KAKAO_JS_KEY=
KAKAO_REST_KEY=

# ─────────────────────────────────────────────
# 이동수단별 경로 API
# ─────────────────────────────────────────────
# 카카오맵 SDK로는 자동차 경로만 가능하다. 나머지는 별도 서비스를 써야 한다.
# 아래 키들은 모두 서버 전용이며 클라이언트로 내보내지 않는다.

# 자차 - 카카오모빌리티 Directions
# https://developers.kakaomobility.com
KAKAO_MOBILITY_KEY=

# 도보 - TMAP 보행자 경로
# https://openapi.sk.com
TMAP_APP_KEY=

# 자전거 - OpenRouteService
# https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# 대중교통 - ODsay
# https://lab.odsay.com
ODSAY_API_KEY=

# ─────────────────────────────────────────────
# 히트맵 - 기상청 단기예보 (공공데이터포털)
# ─────────────────────────────────────────────
# https://www.data.go.kr
# 주의: 기상청 API는 위경도가 아니라 격자 좌표계(nx/ny)를 쓴다. 변환 로직 필요.
KMA_SERVICE_KEY=

# ─────────────────────────────────────────────
# 서버
# ─────────────────────────────────────────────
PORT=8084
# 로컬 개발 시 템플릿 캐시를 꺼두면 수정이 바로 반영된다.
THYMELEAF_CACHE=false
